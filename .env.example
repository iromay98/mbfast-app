# このファイルをコピーして .env を作成してください: cp .env.example .env
# 実際の値はコミットしないこと。

# ── データベース ──────────────────────────────
# 開発(ポータブル版 PostgreSQL / scripts/pg.sh):
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/mbfast?schema=public"
# 本番(VPS の PostgreSQL)例:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mbfast?schema=public&sslmode=require"

# ── 認証 (Auth.js) ────────────────────────────
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-to-a-32byte-random-base64"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ── ファイルストレージ ────────────────────────
# local: VPS のローカルディスク（Web 公開ディレクトリの外）。将来 s3 に差し替え可。
# 【永続化・重要】STORAGE_LOCAL_DIR と PostgreSQL データ領域は、アプリのコード/デプロイ領域とは
# 別の「永続ボリューム」を指すこと。デプロイ(コード更新)でアップロード済みファイルや DB が
# 消えたり再生成されたりしてはならない。本番例: STORAGE_LOCAL_DIR="/srv/mbfast/storage"（コード外）。
# 配信は必ず認可付きエンドポイント経由（公開ディレクトリには絶対に置かない）。
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MAX_UPLOAD_BYTES="52428800" # 50MB

# ── 通知 ──────────────────────────────────────
# console: コンソール出力スタブ（MVP）。本番は line。
NOTIFICATION_DRIVER="console"

# LINE通知（プッシュの保険。全通知を LINE_NOTIFY_TO へ送信。両方揃うと有効）
# トークン: LINE Developers → 該当チャネル → Messaging API設定 → チャネルアクセストークン(長期)
# 宛先ID: LINE Developers → チャネル基本設定 の「あなたのユーザーID」(U…) または グループID(C…)
# LINE_CHANNEL_ACCESS_TOKEN=""
# LINE_NOTIFY_TO=""

# Web Push (VAPID)。生成: npx web-push generate-vapid-keys
# 未設定だとプッシュ通知は全て無効（エラーにはならず送信されない）。
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:saraya@ns-inc.jp"

# メール通知（プッシュの保険。全通知を NOTIFY_EMAIL_TO へ転送。SMTP_HOST と NOTIFY_EMAIL_TO が揃うと有効）
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""           # 省略時は SMTP_USER
# NOTIFY_EMAIL_TO=""     # 例 saraya@ns-inc.jp（カンマ区切りで複数可）

# 加盟店“本人”への登録完了メール（SMTP_HOST だけで有効。NOTIFY_EMAIL_TO は不要）
# 未設定だと登録した店舗に1通も届かない（本部宛てに「送信できませんでした」通知が飛ぶ）
# STORE_MAIL_FROM=""     # 省略時は SMTP_FROM → SMTP_USER の順。例 sale@mbfasttuning.com
# STORE_MAIL_SUPPORT=""  # 返信先/問い合わせ先。省略時は sale@mbfasttuning.com

# ── AutoTuner Master API（スレーブ自動復号） ──
# X-Autotuner-Id: 本店マスター機器ID（8桁hex, 例 20104321）
# X-Autotuner-API-Key: Autotuner サポートから受領する秘密鍵
AUTOTUNER_API_BASE="https://api.autotuner-tool.com/v2/api/v1/master"
AUTOTUNER_ID=""
AUTOTUNER_API_KEY=""
AUTOTUNER_TIMEOUT_MS="30000"
AUTOTUNER_MAX_RETRIES="5"

# ── mbPIT（施工記録→AI記事化→WordPress自動公開） ──
# WP_USER / WP_APP_PASSWORD: WordPress の Application Password（本番 .env のみ・コミット禁止）
# WP_BASE_URL="https://mbfasttuning.com"
# WP_USER=""
# WP_APP_PASSWORD=""
# ANTHROPIC_API_KEY=""
# PIT_ARTICLE_MODEL="claude-sonnet-5"   # 記事生成モデル（コスト重視でsonnet既定）
# AUTO_PUBLISH="true"                    # false で下書き投稿（公開しない）
# STEALTH_MODE="false"                   # "true" のときだけ記事に noindex（URL限定公開に戻す場合のみ）。既定OFF
# PIT_OCR_MODEL="claude-sonnet-5"        # 車検証の読み取りモデル
# SERVER_SECRET: マイカーページ(車のお薬手帳)の vehicle_key 用HMAC鍵。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 【重要】一度発行したら変更しないこと（変更すると既存車両の紐づけが全て無効になる）
# SERVER_SECRET=""
# PII_ENC_KEYS: 車台番号・登録番号の暗号化鍵（AES-256-GCM）。SERVER_SECRETとは別の鍵。
# 形式は "現行キーID:鍵,旧キーID:旧鍵"（先頭が現行鍵。旧鍵を残すと過去データも読める）
# 生成: openssl rand -base64 48
# 【重要】失うと証明書・法定記録簿に車台番号を出力できない（詳細は docs/pii-key-management.md）
# PII_ENC_KEYS="k1:"

# ── Google ビジネスプロフィール（mbPIT: 施工記録のGoogleマップ自動投稿） ──
# 方式A: 認可するGoogleアカウントは mbFAST の1つだけ。加盟店は自店のプロフィールに
# mbFAST を管理者として招待する（加盟店ごとのOAuthは行わない）。
# スコープは https://www.googleapis.com/auth/business.manage のみ。
# OAuthクライアントは「ウェブアプリケーション」で作成し、承認済みリダイレクトURIに
#   http://127.0.0.1:53682/callback        （npm run gbp:auth で使う。必須）
#   http://localhost:53682/callback        （同じ用途の別表記。保険）
#   https://portal.mbfasttuning.com/api/pit/gbp/oauth/callback （将来のアプリ内再認可用に予約）
# を登録する。スコープ文字列をリダイレクトURIに入れないこと（別欄）。
# 取得手順: 上記を登録 → GBP_CLIENT_ID/SECRET を渡して npm run gbp:auth → refresh_token を控える
# 接続確認: npm run gbp:accounts
# GBP_CLIENT_ID=
# GBP_CLIENT_SECRET=
# GBP_REFRESH_TOKEN=
# アカウントID（"accounts/123..." か数字だけ）。指定すると accounts.list を呼ばずに済む。
# Account Management API の割り当てを使わないため、そのAPIが未承認でも先に進める。
# GBP_ACCOUNT_ID=104393726705113377120
#
# 店舗→ロケーションの手動指定（一覧APIを1回も呼ばずに投稿まで到達する経路）。
# キーは店舗の slug（/hq/pit/gbp の一覧に表示）か PitStore.id。値は数字だけでも可。
# Account Management / Business Information の割り当てが下りたら、画面での紐付けに
# 移行してこの指定は削除できる（DBの紐付けが優先される）。
# ※ここに入れるのは識別子で、秘密情報ではない。
# GBP_LOCATION_MAP="honten:18204209748554497603,kisarazu:1600847083813484494"
#
# v4の割り当て確認（投稿を作らずに GET localPosts のみ）: npm run gbp:v4check
# 1日の投稿上限（Create requests per day=100 に対する安全側の既定は80）
# GBP_DAILY_POST_LIMIT=80
#
# 加盟店が自店のGoogleビジネスプロフィールに「管理者」として招待する宛先。
# 方式Aで認可している mbFAST のGoogleアカウントのメールアドレスを入れる。
# ※これは招待先として加盟店に伝える識別子で、秘密情報ではない（画面に表示する）。
# 未設定なら加盟店の連携画面は「本部よりご案内します」と表示する。
# GBP_MANAGER_EMAIL=gbp@mbfasttuning.com

# 価格表のAirtable書き戻し（代理店が貼っているAirtable埋め込みを最新に保つ用）
# 既定は読み取りのみ。書き込みは npm run prices:airtable-push -- --yes のときだけ。
AIRTABLE_PAT=
AIRTABLE_PRICE_BASE_ID=
