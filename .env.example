# このファイルをコピーして .env を作成してください: cp .env.example .env
# 実際の値はコミットしないこと。

# ── データベース ──────────────────────────────
# 開発(ポータブル版 PostgreSQL / scripts/pg.sh):
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/mbfast?schema=public"
# 本番(VPS の PostgreSQL)例:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mbfast?schema=public&sslmode=require"

# ── 認証 (Auth.js) ────────────────────────────
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-to-a-32byte-random-base64"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ── ファイルストレージ ────────────────────────
# local: VPS のローカルディスク（Web 公開ディレクトリの外）。将来 s3 に差し替え可。
# 【永続化・重要】STORAGE_LOCAL_DIR と PostgreSQL データ領域は、アプリのコード/デプロイ領域とは
# 別の「永続ボリューム」を指すこと。デプロイ(コード更新)でアップロード済みファイルや DB が
# 消えたり再生成されたりしてはならない。本番例: STORAGE_LOCAL_DIR="/srv/mbfast/storage"（コード外）。
# 配信は必ず認可付きエンドポイント経由（公開ディレクトリには絶対に置かない）。
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MAX_UPLOAD_BYTES="52428800" # 50MB

# ── 通知 ──────────────────────────────────────
# console: コンソール出力スタブ（MVP）。本番は line。
NOTIFICATION_DRIVER="console"

# LINE通知（プッシュの保険。全通知を LINE_NOTIFY_TO へ送信。両方揃うと有効）
# トークン: LINE Developers → 該当チャネル → Messaging API設定 → チャネルアクセストークン(長期)
# 宛先ID: LINE Developers → チャネル基本設定 の「あなたのユーザーID」(U…) または グループID(C…)
# LINE_CHANNEL_ACCESS_TOKEN=""
# LINE_NOTIFY_TO=""

# Web Push (VAPID)。生成: npx web-push generate-vapid-keys
# 未設定だとプッシュ通知は全て無効（エラーにはならず送信されない）。
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:saraya@ns-inc.jp"

# メール通知（プッシュの保険。全通知を NOTIFY_EMAIL_TO へ転送。SMTP_HOST と NOTIFY_EMAIL_TO が揃うと有効）
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""           # 省略時は SMTP_USER
# NOTIFY_EMAIL_TO=""     # 例 saraya@ns-inc.jp（カンマ区切りで複数可）

# ── AutoTuner Master API（スレーブ自動復号） ──
# X-Autotuner-Id: 本店マスター機器ID（8桁hex, 例 20104321）
# X-Autotuner-API-Key: Autotuner サポートから受領する秘密鍵
AUTOTUNER_API_BASE="https://api.autotuner-tool.com/v2/api/v1/master"
AUTOTUNER_ID=""
AUTOTUNER_API_KEY=""
AUTOTUNER_TIMEOUT_MS="30000"
AUTOTUNER_MAX_RETRIES="5"

# ── mbPIT（施工記録→AI記事化→WordPress自動公開） ──
# WP_USER / WP_APP_PASSWORD: WordPress の Application Password（本番 .env のみ・コミット禁止）
# WP_BASE_URL="https://mbfasttuning.com"
# WP_USER=""
# WP_APP_PASSWORD=""
# ANTHROPIC_API_KEY=""
# PIT_ARTICLE_MODEL="claude-sonnet-5"   # 記事生成モデル（コスト重視でsonnet既定）
# AUTO_PUBLISH="true"                    # false で下書き投稿（公開しない）
# STEALTH_MODE="true"                    # mbPITのURL限定公開中は記事に noindex を付ける。公開解禁時に false
# SERVER_SECRET: マイカーページ(車のお薬手帳)の vehicle_key 用HMAC鍵。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 【重要】一度発行したら変更しないこと（変更すると既存車両の紐づけが全て無効になる）
# SERVER_SECRET=""
