// mbFAST 本店⇄代理店 連携アプリ — Prisma schema
// DB: PostgreSQL（開発はポータブル版 / 本番は VPS の PostgreSQL）
//
// 認証は Auth.js(credentials) + JWT セッションのため、Auth.js のアダプタ用
// テーブル(Account/Session 等)は不要。アプリ独自の User を passwordHash で管理する。

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: 接続 URL は schema ではなく prisma.config.ts(CLI/Migrate 用) と
  // PrismaClient のドライバアダプタ(実行時) で指定する。
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────
enum Role {
  HQ_ADMIN // 本店管理者
  DEALER   // 代理店
}

enum DealerStatus {
  ACTIVE
  INACTIVE
}

enum WorkType {
  TUNING         // チューニング
  POPS_AND_BANGS // バブリング (Pops & Bangs)
  TCU            // TCU
  OTHER          // その他
}

enum RequestStatus {
  RECEIVED    // 受付
  IN_PROGRESS // 作業中
  DELIVERED   // 納品
  CANCELLED   // キャンセル
}

enum AnnouncementCategory {
  NOTICE  // お知らせ
  TECH    // 技術情報
  PRICING // 価格改定
}

enum ShowcaseVisibility {
  PUBLIC // 一般公開（未ログインでも閲覧可）
  DEALER // 代理店・本店のみ
}

// 施工記録の取り込み状態（スレーブアップロード起点の自動生成パイプライン）
enum RecordStatus {
  UPLOADED   // スレーブ受領・解析待ち（一覧では「解析中」プレースホルダ表示）
  DECRYPTING // AutoTuner decrypt 実行中
  DECODED    // 復号成功・メタ充足済み（手動作成レコードもこの状態を流用）
  FAILED     // 復号失敗
}

// 施工記録の由来
enum RecordSource {
  MANUAL       // 手動起票
  SLAVE_UPLOAD // スレーブアップロードによる自動生成
}

// チューニング済みファイル(カタログ)の公開状態
enum VariantStatus {
  DRAFT     // 下書き（代理店に出さない）
  AVAILABLE // 配布可（照合で代理店に提示・DL可）
  DISABLED  // 無効化（照合対象外・非表示）
}

// ダウンロードの文脈（監査ログ用）
enum DownloadContext {
  MATCH_AUTO // 照合一致による代理店の自動DL
  HQ_MANUAL  // 本店による手動DL
}

// BaseFile(純正/ストック)の由来
enum BaseFileSource {
  AUTO_CAPTURE // 復号パイプラインから自動取込（未整備ストック）
  MANUAL       // 本店が手動登録
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  dealerId     String?
  dealer       Dealer?  @relation(fields: [dealerId], references: [id])
  createdAt    DateTime @default(now())
  // 本人がパスワードを変更した日時。null=初期PWのまま（本部把握可）/ 非null=本人変更済み（本部は不明）。
  passwordChangedAt DateTime?

  serviceRecords     ServiceRecord[] @relation("RecordCreatedBy")
  publishedAnnounces Announcement[]  @relation("AnnouncePublishedBy")
  publishedShowcases Showcase[]      @relation("ShowcasePublishedBy")
  requestEvents      RequestEvent[]  @relation("EventActor")
  recordMessages     RecordMessage[] @relation("MessageAuthor")

  // カタログ（本店専用）
  createdBaseFiles  BaseFile[]             @relation("BaseFileCreatedBy")
  createdVariants   TunedVariant[]         @relation("VariantCreatedBy")
  replacedVersions  TunedVariantVersion[]  @relation("VersionReplacedBy")
  catalogDownloads  CatalogDownloadLog[]   @relation("DownloadByUser")
  pushSubscriptions PushSubscription[]     @relation("UserPushSubs")

  @@index([dealerId])
}

// 本店専用の顧客関連ファイル（代理店には一切公開しない）。
// 見積・現車データ・作業メモの添付など。備考付き。
model RecordHqFile {
  id              String        @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  filePath        String // ストレージ参照キー
  fileName        String
  fileSize        Int?
  contentType     String?
  note            String? // 備考（何のファイルか）
  uploadedById    String?
  createdAt       DateTime      @default(now())

  @@index([serviceRecordId])
}

// 手動の施工ログ。自動の活動履歴(DL/依頼)とは別に、過去客の遡り登録など
// 「いつ・何を施工したか」を本店が手で記録するためのもの。
model ServiceLog {
  id              String        @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  performedAt     DateTime // 施工日（過去日OK）
  content         String // 施工内容（例 Stage1＋バブリング）
  note            String? // 補足メモ
  authorId        String? // 記録者（任意）
  createdAt       DateTime      @default(now())

  @@index([serviceRecordId])
}

// 本店が確定(修正)した識別子の実例。AI識別のfew-shot例として使い、メーカー別に
// Cal/SW/HW の形式を学習させる（修正を次に活かす自己学習）。
model EcuExample {
  id           String   @id @default(cuid())
  manufacturer String
  ecu          String?
  cal          String?
  sw           String?
  hw           String?
  createdAt    DateTime @default(now())

  @@index([manufacturer])
}

// 候補トークンがどのファイル(hash)に出たかの記録。複数の無関係なファイルに共通する値
// （定数：ベンツの或るCalがアバルトにも出る等）を検出して、AI候補から除外するため。
model EcuTokenSeen {
  token String
  hash  String

  @@id([token, hash])
  @@index([token])
}

// AI(Claude)による識別子抽出のキャッシュ。同一ファイル(内容hash)は再呼び出ししない。
model EcuAiCache {
  hash       String   @id // 復号後内容の SHA-256（大文字16進）
  hw         String?
  sw         String?
  cal        String?
  confidence Float? // 0-1
  model      String? // 使用モデル（haiku/opus）
  createdAt  DateTime @default(now())
}

// Web Push 購読（ブラウザごと）。アプリ終了時もチャット新着を通知するため。
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique // ブラウザの push endpoint（一意）
  p256dh    String // 公開鍵
  auth      String // 認証シークレット
  userId    String
  user      User     @relation("UserPushSubs", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Dealer {
  id              String       @id @default(cuid())
  name            String // 店名
  address         String?
  lat             Float? // 地図用座標
  lng             Float?
  phone           String?
  email           String?
  status          DealerStatus @default(ACTIVE)
  autotunerToolId String? // スレーブツールID等のメモ
  // やり取りするファイル形式。SLAVE=AutoTunerスレーブ（既定）/ MASTER=Powergate3のMaster File(生bin)。
  // 子会社OBLY(Rig Tuning)等、Powergateでやり取りする代理店は MASTER。
  fileFormat      String       @default("SLAVE")
  // mbPIT専用アカウント（招待リンクから自己登録した外部店舗）。
  // true の場合はブログ投稿機能のみ利用可能で、ECU系の画面（施工記録・依頼・価格表等）は見せない。
  pitOnly         Boolean      @default(false)
  // ECU業務を行う代理店か。false なら「施工依頼・記録」のECU特殊機能を出さない
  // （コーティング等の別業種の代理店向け）。既定 true＝既存の代理店はそのままON。
  // pitOnly の外部加盟店ではこのフラグは参照しない（ECU画面自体を出さないため）。
  ecuEnabled      Boolean      @default(true)
  note            String?
  createdAt       DateTime     @default(now())

  users          User[]
  serviceRecords ServiceRecord[]
  fileRequests   FileRequest[]
  reads          AnnouncementRead[]
  catalogDownloads CatalogDownloadLog[]
  pitStore         PitStore?
}

// 施工記録 / 愛車カルテ
model ServiceRecord {
  id             String   @id @default(cuid())
  dealerId       String // 施工した代理店
  dealer         Dealer   @relation(fields: [dealerId], references: [id])
  // アップロード起点では未確定のため必須項目を nullable 化（後から自動/手動で充足）
  vin            String? // 車台番号（手動で後入力）
  carMaker       String? // ← decrypt: manufacturer
  carModel       String? // ← decrypt: model
  carYear        Int?
  ecuType        String? // ← decrypt: ecu（ECU 型式）
  tcuType        String?
  softwareNumber String? // SW番号（decrypt レスポンスに該当無し・手動入力のみ）
  workType       WorkType? // 施工種別（手動で後選択）
  appliedMap     String? // 適用マップ名/識別子
  workedAt       DateTime @default(now()) // 施工日（スレーブ経路は受領日を初期値に）
  photoPaths     String[] @default([]) // 写真(ストレージ参照キー配列)
  customerName   String? // 顧客名（代理店が入力・自店と本店が閲覧）
  note           String? // 代理店と共有のメモ
  hqNote         String? // 本店専用メモ（代理店には一切見せない）

  // ── 取り込み制御 ──
  status            RecordStatus @default(DECODED) // 手動作成は DECODED、スレーブ経路は UPLOADED→…
  source            RecordSource @default(MANUAL)
  slaveFilePath     String? // アップされたスレーブ（ストレージ参照キー）
  decryptedFilePath String? // 復号後バイナリ（ストレージ参照キー）
  decryptError      String? // 失敗理由
  slaveHash         String? // アップ slave の SHA-256（呼び出し前の重複検出キー）
  decryptedHash     String? // decrypt レスポンスの hash（整合検証・内容重複）

  // ── AutoTuner decrypt メタ（自動充足） ──
  mcu             String? // ← decrypt: mcu
  method          String? // ← decrypt: method（読み方式）
  ecuManufacturer String? // ← decrypt: ecu_manufacturer
  slaveName       String? // ← decrypt: slave_name
  engineInfo      Json? // ← decrypt: engine オブジェクト全体
  backupSupported Boolean? // ← decrypt: backup_supported（true=リアル読み→純正復元は backup / false=ヴァーチャル→ori）
  // アップしたスレーブが既にチューニング済みか。true=純正ではない（ori扱いしない・カタログ自動取込しない）。
  isTuned         Boolean  @default(false)
  // 実車開発モード: ONのとき代理店の記録詳細に開発カード（現在ノード＋良い/ダメ報告）を表示
  devMode          Boolean @default(false)
  devCurrentNodeId String?
  // true = 代理店が自分でツリー内のノードを選んで切り替えられる（本部が許可制でON）
  devFreeChoice    Boolean @default(false)
  // 左右ECU: メイン（この記録の既存フィールド）側の表示ラベル。2基目は RecordEcuSide。
  primarySide      String  @default("左")
  // AI推定の車両情報（AutoTunerメタ＋dump からの推定。照合前の表示・カタログ登録の下書きに使う）
  carGrade         String?
  carGeneration    String?
  // 対象ユニット "ECU" | "TCU"。同時施工での取り違え防止（表示・ファイル名に使用）。
  unit            String   @default("ECU")
  // チューンド車用: 本店が事前アップする純正(ori)bin。代理店はこれを ori .slave でいつでもDLできる。
  oriFilePath String?
  oriFileName String?
  oriFileHash String? // SHA-256（.slave暗号化キャッシュのキー）

  // ── encrypt（再暗号化）用に保存（今回 encrypt は未実装） ──
  autotunerSlaveId String? // ← decrypt: slave_id
  autotunerEcuId   Int? // ← decrypt: ecu_id
  autotunerModelId Int? // ← decrypt: model_id
  autotunerMcuId   String? // ← decrypt: mcu_id

  // ── 車検証（電子車検証 二次元コード）から取得した車両情報 ──
  registrationNumber    String? // 自動車登録番号・車両番号（ナンバー）
  vehicleModelCode      String? // 型式（例 DBA-GRS214）
  engineModelCode       String? // 原動機型式
  modelDesignationNumber String? // 型式指定番号・類別区分番号
  firstRegistration     String? // 初度登録年月（YYYY-MM）
  inspectionExpiry      String? // 有効期間満了日（YYYY-MM-DD・電子車検証券面からは取得不可）
  shakenScanRaw         Json? // 読み取り生データ {code2, code3}（監査・再解析用）

  // ── ECU 識別子（復号後バイナリから自動抽出・手修正可。Cal が管理の主キー） ──
  hwNumber  String? // HW 部品番号（例 07K907309C）
  swNumber  String? // SW 番号（例 8V0907404）
  calNumber String? // Cal（既定は SW+バージョン。最重要・検索/整理の主キー）
  ecuIdRaw  Json? // 抽出した全項目＋生の識別ブロック（監査・再解釈用）
  // 識別子の由来: "AI"=AI自動認識(未確認) / "MANUAL"=本店確定 / "PATTERN"=パターン抽出。
  idSource     String?
  idConfidence Float? // AIの確信度(0-1)

  // ── カタログ照合（復号hashが BaseFile.stockHash と一致したら設定） ──
  matchedBaseFileId String?
  matchedBaseFile   BaseFile? @relation("RecordMatchedBase", fields: [matchedBaseFileId], references: [id])

  createdById String
  createdBy   User     @relation("RecordCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  deletedAt   DateTime? // ソフト削除（アーカイブ）。非null=削除済み（一覧から除外・復元可）。

  fileRequests FileRequest[] // この記録に紐づく依頼
  apiLogs      AutotunerApiLog[] // AutoTuner API 呼び出しログ
  catalogDownloads CatalogDownloadLog[] // この記録起点のカタログDL監査
  messages     RecordMessage[] // 案件ごとの本部⇄代理店メッセージ
  serviceLogs  ServiceLog[] // 手動の施工ログ（過去客の遡り登録等）

  @@index([deletedAt])
  @@index([dealerId])
  @@index([vin])
  @@index([softwareNumber])
  @@index([workType])
  @@index([workedAt])
  @@index([status])
  @@index([slaveHash])
  @@index([decryptedHash])
  @@index([matchedBaseFileId])
  @@index([swNumber])
  @@index([calNumber])
  hqFiles RecordHqFile[]
  devNodes DevNode[]
  ecuSides RecordEcuSide[]

}

// AutoTuner API 呼び出しログ（監査）
model AutotunerApiLog {
  id         String         @id @default(cuid())
  recordId   String?
  record     ServiceRecord? @relation(fields: [recordId], references: [id])
  mode       String // "maps"
  httpStatus Int? // HTTP ステータス（ネットワークエラー時は null）
  success    Boolean
  error      String?
  createdAt  DateTime       @default(now())

  @@index([recordId])
  @@index([createdAt])
}

// 本店への作業依頼
model FileRequest {
  id              String         @id @default(cuid())
  dealerId        String // 依頼元代理店
  dealer          Dealer         @relation(fields: [dealerId], references: [id])
  title           String
  carInfo         String? // 車両情報の自由記述
  vin             String?
  ecuType         String?
  requestNote     String? // 依頼内容
  inputFilePath   String? // 代理店がアップしたスレーブ/読み出しファイル(ストレージ参照キー)
  status          RequestStatus  @default(RECEIVED)
  // 本店が「重要」を立てた依頼。一覧で最上位に固定する（急ぎ・トラブル対応の見落とし防止）。
  // 状態(status)とは独立＝作業中でも新規でも立てられる。
  priority        Boolean        @default(false)
  // 誤リクエストのキャンセルフロー: 代理店が依頼→本店が承諾(status=CANCELLED)/却下。
  cancelRequestedAt DateTime?
  cancelReason      String?
  cancelRejectedAt  DateTime?
  resultFilePath  String? // 本店が返す成果ファイル(ストレージ参照キー)
  hqNote          String? // 本店からのコメント
  serviceRecordId String? // 完了時に紐づける施工記録
  serviceRecord   ServiceRecord? @relation(fields: [serviceRecordId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  events RequestEvent[] // 監査用 状態変更履歴

  @@index([dealerId])
  @@index([status])
}

// 監査: 依頼の主要な状態変更を残す（誰が・いつ・どの状態へ）
// 案件(施工記録)ごとの本部⇄代理店メッセージ（本部はテストファイル送付、代理店は質問・別リクエスト）。
model RecordMessage {
  id              String        @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation("MessageAuthor", fields: [authorId], references: [id])
  authorRole      Role // 送信者のロール（本部/代理店）
  body            String? // 本文
  filePath        String? // 添付ファイル（ストレージ参照キー）
  fileName        String?
  fileSize        Int?
  contentType     String?
  // 送信取り消し（削除済み表示。本文/ファイルは配信停止）
  deletedAt       DateTime?
  // 添付ファイルの備考（本部・代理店それぞれが書ける「このファイルどうだった」メモ）
  hqNote          String?
  dealerNote      String?
  // 本部が添付ファイルの再DL可否を制御（false=以後DL不可）。既定は可。
  redownloadable  Boolean       @default(true)
  // 相手が添付を初回DLした日時（DL済みステータス表示用）
  downloadedAt    DateTime?
  createdAt       DateTime      @default(now())

  @@index([serviceRecordId])
}

model RequestEvent {
  id        String        @id @default(cuid())
  requestId String
  request   FileRequest   @relation(fields: [requestId], references: [id])
  status    RequestStatus
  comment   String?
  actorId   String // 操作した User.id
  actor     User          @relation("EventActor", fields: [actorId], references: [id])
  createdAt DateTime      @default(now())

  @@index([requestId])
}

model Announcement {
  id            String               @id @default(cuid())
  title         String
  body          String // Markdown 可
  category      AnnouncementCategory
  publishedById String
  publishedBy   User                 @relation("AnnouncePublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime             @default(now())

  reads AnnouncementRead[]

  @@index([category])
  @@index([publishedAt])
}

// 施工事例（ショーケース）。車両でドリルダウンして閲覧。
// 動画/ブログ/Instagram等は「DLせずリンク/iframe埋め込み」で掲載（著作権配慮）。
model Showcase {
  id           String             @id @default(cuid())
  title        String
  comment      String? // 本文（Markdown可・「このバブリングは○○」等）
  // 車両（ドリルダウン用。作成時に施工記録/純正からコピー）
  carMaker     String
  carModel     String
  generation   String?
  grade        String?
  stage        String? // 例 Stage1
  contentLabel String? // 例 「Stage1・バブリング」
  // 埋め込み配列 [{kind:"youtube"|"instagram"|"link", url, title?}]。実体はDLせずリンク/iframe。
  embeds       Json               @default("[]")
  coverImage   String? // 任意：カバー画像の外部URL（自社撮影のみ）
  visibility   ShowcaseVisibility @default(PUBLIC)
  createdFromRecordId String?

  publishedById String
  publishedBy   User     @relation("ShowcasePublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([carMaker, carModel])
  @@index([visibility])
  @@index([publishedAt])
}

// 既読管理（代理店単位）
model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  dealerId       String
  dealer         Dealer       @relation(fields: [dealerId], references: [id])
  readAt         DateTime     @default(now())

  @@id([announcementId, dealerId])
}

// ─────────────────────────────────────────────
// カタログ（チューニング済みファイル）— 本店専用
// ─────────────────────────────────────────────

// ストック(原本)識別＝照合アンカー。stockHash の完全一致で代理店の復号結果と突合する。
model BaseFile {
  id           String  @id @default(cuid())
  stockHash    String? @unique // 復号後(ストック)内容の SHA-256。照合キー。
  manufacturer String
  model        String
  ecu          String
  mcu          String?
  note         String?

  // ECU 識別子（原本バイトから自動抽出。Cal は管理の主キー）
  hwNumber   String?
  swNumber   String?
  swSeq      Int     @default(0) // 同一SW・別内容(hash)の通し番号。0=無印, 1=-A, 2=-B…
  calNumber  String?
  generation   String? // 世代（例 8V / W222）＝復号 engine.version 由来 or 手入力
  grade        String? // グレード/車格（任意・手入力 例 S550, RS3, S-class）
  engineCode   String? // エンジン型式（任意・手入力 例 CZGB）
  displacement String? // 排気量（任意・手入力 例 2.5L）。原本binから推定して既定値にする
  method       String? // 読み方式（例 OBD / Bench / Boot）
  // 読み取りツール（ファイル名のツールトークン）。AT=AutoTuner / PG3=Powergate3 / K3=Kess3 / 任意追加可。
  tool         String  @default("AT")
  // 準用グループ: 同一キャリブレーションで別ツール/Methodの純正どうしを紐付ける任意キー。
  // 同じ値の BaseFile は「ニコイチ（キャリブ転写）」の準用候補として提示される。
  substituteKey String?
  fuel       String? // 燃料（petrol/diesel 等）＝復号 engine.fuel 由来。OP/バブの出し分けに使用

  // ECM Titanium 等の Driver 情報（本店のみ・代理店には一切出さない）。純正(ECU)基準で管理。
  driver         String? // 使用 Driver 名（自動認識タイプ or 流用元の名前）
  driverBorrowed Boolean @default(false) // true=他Driverの流用（表示時に名前を ()で囲う）

  // スピードリミッターカット不可（この純正＝Calでは作れない）。本店が設定。
  // 代理店がリミッターカットを選んだら「不可」とし、リミッターカット無しの同一内容へ誘導する。
  limiterCutDisabled Boolean @default(false)

  // 対象ユニット "ECU" | "TCU"。同時施工での取り違え防止（表示・ファイル名に使用）。
  unit String @default("ECU")

  // 原本(チューニング前)ファイルの実体（任意）。公開ディレクトリ外・認可配信のみ。
  stockFileRef     String?
  stockFileName    String?
  stockFileSize    Int?
  stockContentType String?

  // 由来・整備状態
  source              BaseFileSource @default(MANUAL)
  archived            Boolean        @default(false) // 候補の却下/非表示
  capturedFromRecordId String? // 自動取込元の施工記録（監査・FKなし）

  createdById String?
  createdBy   User?    @relation("BaseFileCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants       TunedVariant[]
  matchedRecords ServiceRecord[] @relation("RecordMatchedBase")

  @@index([manufacturer])
  @@index([model])
  @@index([ecu])
  @@index([source])
  @@index([archived])
  @@index([calNumber])
}

// チューニング済み納品物（グリッドの1行）。1つの BaseFile に複数(stage1/stage1+pops/…)。
model TunedVariant {
  id           String        @id @default(cuid())
  baseFileId   String
  baseFile     BaseFile      @relation(fields: [baseFileId], references: [id])
  stage        String        @default("") // 例: Stage1
  popsAndBangs Boolean       @default(false) // バブリング有無
  popsSport    Boolean       @default(false) // true=スポーツモードのみ / false=全モード（既存は全モード）
  optionTags   String[]      @default([]) // 構造化オプション（Adblue/DTC/EGR/DPF 等）
  options      String? // 自由記述メモ・備考（本店のみ。例「テスト用・強すぎ」）
  status       VariantStatus @default(DRAFT)
  note         String?

  // 現行版のキャッシュ（グリッド表示・照合の高速化用）。実体は Version 群に保持。
  currentVersionId String?              @unique
  currentVersion   TunedVariantVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  fileRef          String?
  fileHash         String? // 現行ファイルの SHA-256
  fileName         String?
  fileSize         Int?
  contentType      String?

  createdById String?
  createdBy   User?    @relation("VariantCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // ソフト削除（アーカイブ）。非null=削除済み（カタログ/照合から除外・復元可）。

  versions  TunedVariantVersion[] @relation("VariantVersions")
  downloads CatalogDownloadLog[]

  @@index([baseFileId])
  @@index([status])
  @@index([stage])
  @@index([fileHash])
  @@index([deletedAt])
}

// ECU識別子(HW/SW/Cal)の学習ルール（本店の手入力から学習・ローカル/外部API不要）。
// EXACT: 内容hash一致のファイルに固定値を返す。MARKER: ECU型式ごとに「目印+トークン形」で抽出。
model EcuRule {
  id               String   @id @default(cuid())
  field            String // "HW" | "SW" | "CAL"
  kind             String // "EXACT" | "MARKER"
  matchKey         String // EXACT=内容hash / MARKER=ECU型式（無ければ "*"）
  value            String? // EXACT=採用値 / MARKER=学習元の例(sample)
  beforeMarker     String? // MARKER: トークン直前のASCII目印
  tokenRegex       String? // MARKER: トークンの形（正規表現）
  sourceBaseFileId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([kind])
  @@index([field])
  @@index([matchKey])
}

// 差し替え履歴。現行版がどれかは TunedVariant.currentVersionId で常に明示。
model TunedVariantVersion {
  id          String       @id @default(cuid())
  variantId   String
  variant     TunedVariant @relation("VariantVersions", fields: [variantId], references: [id], onDelete: Cascade)
  version     Int
  fileRef     String
  fileHash    String
  fileName    String?
  fileSize    Int?
  contentType String?
  // 本店用メタ: ver名（例 "ver2"・"-15 2000~"）と特徴メモ（例 "強め・触媒無視前提"）。
  label String?
  note  String?
  replacedAt  DateTime     @default(now())
  replacedById String?
  replacedBy   User?       @relation("VersionReplacedBy", fields: [replacedById], references: [id])

  currentOf TunedVariant? @relation("CurrentVersion")
  downloads CatalogDownloadLog[]

  @@unique([variantId, version])
  @@index([variantId])
}

// ダウンロード監査（いつ・誰が・どのファイルを）。本店手動DL/代理店自動DLの両方を記録。
model CatalogDownloadLog {
  id        String          @id @default(cuid())
  variantId String? // 版が削除されたら null（監査ログ自体は残す）
  variant   TunedVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  versionId String?
  version   TunedVariantVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  fileHash  String?

  userId    String?
  user      User?    @relation("DownloadByUser", fields: [userId], references: [id])
  dealerId  String?
  dealer    Dealer?  @relation(fields: [dealerId], references: [id])
  serviceRecordId String?
  serviceRecord   ServiceRecord? @relation(fields: [serviceRecordId], references: [id])

  context   DownloadContext
  ip        String?
  // 誤DLのキャンセルフロー: 代理店が依頼→本店が承諾(cancelledAt)/却下(cancelRejectedAt)。
  // cancelledAt が入ったDLは課金判定(getDownloadFee)から除外される。
  cancelRequestedAt DateTime?
  cancelReason      String?
  cancelledAt       DateTime?
  cancelRejectedAt  DateTime?
  createdAt DateTime        @default(now())

  @@index([variantId])
  @@index([dealerId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// 価格表（mbFAST Tuning の公開価格。WordPressへ貼るHTMLの元データ）
// ─────────────────────────────────────────────

// ブランド定義。列構成がブランドごとに違うため columns(Json) で動的に持つ。
model PriceBrand {
  id                String   @id // "bmw" / "mercedes_gasoline" / "mercedes_diesel" / "audi" / "lamborghini"
  displayName       String // "BMW"
  slug              String   @unique // URL用
  namespacePrefix   String // "bmw-" 等（CSS/ID衝突防止）
  seriesGroups      String[] @default([]) // フィルタチップ
  columns           Json     @default("[]") // ColumnDefinition[]
  csvMapping        Json     @default("{}") // CSV列名 → 内部キー（一括編集/バックアップの入出力用）
  intro             String   @default("") // 表の導入文（HTML可）
  jsonLdDescription String   @default("") // SEO(JSON-LD Service)
  wordPressPageId   Int? // Phase 2: 反映先WPページID
  blockIndex        Int      @default(0) // 同一WPページ内の対象 wp:html ブロック位置（例: mbd=2。mb と同居）
  layout            Json     @default("{}") // ライブHTMLから実測した版面: {naming, ids, classes, minWidth, note ...} — parse-wp.mts の BrandLayout 形
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vehicles PriceVehicle[]
}

// 価格表の1行（1車両）。価格列はブランドで異なるため prices(Json) に動的キーで保持。
model PriceVehicle {
  id           String     @id @default(cuid())
  brandId      String
  brand        PriceBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // price-sync-spec v1 準拠: 市場（JP/EN別レコード）・初期取込元・WooCommerce商品ID（EN用）
  market       String     @default("JP")
  source       String     @default("html") // html | airtable
  wcProductId  Int?
  seriesGroup  String // "3-Series" 等（フィルタ用）
  carName      String // "3-Series (G20)"
  grade        String? // "340i"（Audi等は無し）
  engine       String     @default("") // "B58"（Lamboは無し）
  engineFamily String? // バッジ表示用
  ecuType      String? // "MG1CS003"（右端列）
  stockOutput  String? // "382ps/500Nm"
  stage1Gain   String? // "+80ps/60Nm"
  prices       Json       @default("{}") // { babble: "121000", stage1: "165000", stage2: "ASK" }
  labor        String?
  shops        String?
  remote       Json       @default("{}") // { autoTuner, powerGate3, flasher, atOne }
  notes        String? // ★マーク＋ツールチップ
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([brandId, displayOrder])
  @@index([brandId, seriesGroup])

  page VehiclePage?
}

// 車両バリアント個別ページ（/tuning/{brand}/{slug}/ のJP/EN 2枚を1レコードで管理）。
// マスタは PriceVehicle（market=JP の行に紐付ける）。EN価格は market=EN の別レコードを
// (brandId, carName, grade) で照合して読む。価格を直すのは PriceVehicle だけ＝ページは生成物。
model VehiclePage {
  id           String       @id @default(cuid())
  vehicleId    String       @unique // market=JP の PriceVehicle
  vehicle      PriceVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  slug         String       @unique // "c-w204-c63amg"（親ページ /tuning/{brandSlug}/ の下）
  status       String       @default("hold") // hold(生成しない) | draft(WP下書き) | publish
  options      Json         @default("{}") // { coldStartOff: true, ... } 対応オプションの○×
  relatedPosts Json         @default("[]") // [{ id, title, url }] 同型式の施工実績記事
  enPriceMode  String       @default("quote") // quote(価格非表示・見積CTA) | price(EN価格を表示)
  wpPageIdJp   Int? // 生成先WPページID（push時に書き戻す）
  wpPageIdEn   Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

// ── mbPIT: 施工記録→自動ブログ公開 ──

// 店舗マスタ（既存Dealerに1:1で紐づく）。footer等の公開ルールはDBに持ち、アプリ更新なしで変えられるようにする。
model PitStore {
  id           String   @id @default(cuid())
  dealerId     String?  @unique // null = 本店直営（代理店に紐づかない店舗。本部が直接投稿する）
  dealer       Dealer?  @relation(fields: [dealerId], references: [id])
  displayName  String // 記事タイトル・フッターに使う表示名
  slug         String   @unique // 店舗短slug（/mbpit/{slug}/ と記事slug末尾に使用。WPカテゴリslugから -mbpit を除去した値。確定後は変更禁止）
  wpCategoryId Int // WordPress店舗カテゴリID（親545配下）
  footerHtml   String   @default("") // 記事末尾の店舗紹介＋CTAブロック（更家さんから受領して投入）
  faqJson      Json     @default("[]") // AIO用FAQ: [{q,a}]（任意）
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── 店舗マスター（アプリが原本・WP term meta へ投影。マッピングは src/server/pit/store-meta.ts に集約） ──
  area           String    @default("") // → mbpit_area
  address        String    @default("") // → mbpit_address
  hours          String    @default("") // → mbpit_hours
  closedDays     String    @default("") // → mbpit_closed
  tel            String    @default("") // → mbpit_tel
  email          String    @default("") // → mbpit_email
  website        String    @default("") // → mbpit_website
  lineUrl        String    @default("") // → mbpit_line（公式LINE。HP側で問い合わせボタンになる）
  serviceTags    String    @default("") // → mbpit_tags（読点区切り）
  intro          String    @default("") // → mbpit_intro（1〜3文）
  contactPerson  String    @default("") // 担当者名（WPへは同期しない）
  internalNote   String    @default("") // 社内メモ（WPへは同期しない）
  plan           String    @default("record") // record/grow/brand（将来の課金プラン・現在未使用）
  wpCategorySlug String    @default("") // WP側category slugの実値（-mbpit接尾辞を含む）
  wpPageId       Int? // 店舗固定ページID（/mbpit/{slug}/）
  lastSyncedAt   DateTime? // 店舗情報の最終WP同期時刻

  // 事業場の区分。法定記録簿モードの出し分けに使う（certified/designated のみON）
  facilityType    String @default("general") // certified | designated | general
  certificationNo String @default("") // 認証番号（自動補完・推測はしない）

  /*
   * 施工証明書の体裁と記載範囲（店舗ごとの設定）。**WPへは同期しない**
   * （store-meta.ts の STORE_META_FIELDS に載せないことで構造的に保証）。
   *
   * certBrandName … 帳票の左上に出す「その店舗のブランド名」。会社名ではない（例: Charism）。
   *                 空なら displayName にフォールバックする。右下の mbPIT VERIFIED 証紙は共通。
   * certShow*     … お客様へ渡す証明書・共有ページに何を載せるか。個人情報保護の都合で
   *                 店舗が外せるようにする。**法定記録簿モードでは必須記載事項を外せない**
   *                 （認証/指定工場は氏名・住所が法令上の必須。判定は cert-display.ts が原本）。
   *                 保存する値は変えない＝載せないだけ（記録の保存義務は事業者に残る）。
   */
  certBrandName           String  @default("")
  certShowCustomerName    Boolean @default(true)
  certShowCustomerAddress Boolean @default(true)
  certShowCustomerTel     Boolean @default(true)
  certShowAmount          Boolean @default(true) // 施工金額・再施工費用の目安

  /*
   * AI記事を公開前に人が確認するか。true なら WordPress へ下書きで投稿して
   * PitPost.status="review" で止め、店舗が本文を見てから公開する。
   * false（既定）は従来どおり生成してそのまま公開。
   */
  postReviewRequired Boolean @default(false)

  /*
   * Googleビジネスプロフィール（施工記録のGoogleマップ投稿）。
   * 紐付けは必ず人が選ぶ（店名の表記ゆれで別の店に投稿する事故を防ぐため自動照合はしない）。
   * gbpLocationId は一意＝1つのロケーションを2店舗に割り当てられない。
   */
  gbpAccountId      String    @default("") // "accounts/123..."
  gbpLocationId     String?   @unique // "locations/456..."（未紐付けは null）
  gbpLocationName   String    @default("") // Google側の表示名（照合確認用に保持）
  gbpLocationAddr   String    @default("") // 紐付け時点のGoogle側住所（照合の記録）
  gbpLinkedAt       DateTime?
  gbpLinkedByUserId String? // 誰が紐付けたか（誤配信の追跡用）
  gbpPostingEnabled Boolean   @default(false) // 投稿の有効・無効（既定は無効）

  posts        PitPost[]
  customers    PitCustomer[]
  certificates PitCertificate[]
}

// 加盟店の顧客カルテ（店舗ごとの顧客台帳）。車検満了日で「そろそろ車検」の声かけができる。
// 個人情報のためHQ画面には出さない（自店のみ・requireDealerで強制）
model PitCustomer {
  id               String    @id @default(cuid())
  storeId          String
  store            PitStore  @relation(fields: [storeId], references: [id])
  name             String // 顧客名
  kana             String    @default("") // ふりがな（並び・検索用）
  tel              String    @default("")
  vehicleName      String    @default("") // 車両（例: アルファード 30系）
  inspectionExpiry DateTime? // 車検満了日
  note             String    @default("") // カルテメモ（施工内容・好み・注意点など）
  address          String    @default("") // 住所（法定記録簿の依頼者住所・非公開）
  email            String    @default("")
  vehicleId        String? // 車検証QR連携（PitVehicle）との紐づけ（将来: 施工履歴の自動表示）
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  certificates PitCertificate[]
  vehicleLinks PitVehicleCustomer[]
  consents     PitConsent[]

  @@index([storeId, inspectionExpiry])
}

// 店舗情報→WP term meta 同期のログ（価格同期 PriceSyncLog と同じ思想）
model PitStoreSyncLog {
  id          String   @id @default(cuid())
  storeId     String
  payloadHash String
  status      String // success | skipped | failed | dry-run | ingest
  error       String?
  prevMeta    Json? // 書き込み直前のWP側meta（失敗時の復旧確認用）
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
}

// mbPIT加盟店の招待（自己登録用）。本部が発行した推測不能トークンのURLを店舗に渡し、
// 店舗が自分でアカウント＋店舗情報（店舗名・slug）を登録する。登録後は本部の承認待ち。
model PitInvite {
  id        String    @id @default(cuid())
  token     String    @unique // URL に含める推測不能トークン（base64url 24bytes）
  note      String    @default("") // 本部用メモ（どの店に渡したか）
  usedAt    DateTime? // 使用済み日時（単回使用）
  storeId   String? // 登録で作成された PitStore.id
  createdAt DateTime  @default(now())
}

// 車両（車のお薬手帳）。車検証QRの車台番号から HMAC-SHA256(SERVER_SECRET) で導出した
// vehicleKey で一意化する。車台番号の平文はDBに保存しない（PII保護）。
model PitVehicle {
  id               String    @id @default(cuid())
  vehicleKey       String    @unique // HMAC-SHA256(車台番号, SERVER_SECRET) hex ＝車両の一意キー
  chassisLast3     String? // 表示用（車台番号の下3桁のみ）
  vehicleName      String? // 車種表示（最初に紐づいた記録の車種）
  modelCode        String? // 型式（QRから取得できた場合）
  inspectionExpiry DateTime? // 車検有効期限（リマインド用）
  // ── 証明書・法定記録簿の出力に必要な非公開項目 ──
  // 車台番号/登録番号は平文で持たず AES-256-GCM で暗号化して保存する
  // （復号は src/server/pit/vin-crypto.ts のみ。公開ブログ生成からは参照不可）
  vinEnc            String? // 車台番号（暗号化）
  regNumberEnc      String? // 登録番号＝ナンバー（暗号化・非公開）
  maker             String? // メーカー（公開可）
  firstRegisteredOn DateTime? // 初度登録年月（公開可）
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  posts         PitPost[]
  certificates  PitCertificate[]
  customerLinks PitVehicleCustomer[]
}

// 車両情報の修正履歴（誰がいつ何を直したか）。
// 車両は店舗をまたいで共有されるため、他店が入れた値を上書きした事実を追えるようにする。
// 個人情報の「復号」は PitPiiAccessLog、「変更」はこちらに残す（読みと書きを混ぜない）。
model PitVehicleEditLog {
  id          String   @id @default(cuid())
  vehicleId   String
  storeId     String
  actorUserId String
  // { field: { before, after } } の形。登録番号は値そのものを残さず "変更" だけ記録する
  changes     Json
  at          DateTime @default(now())

  @@index([vehicleId, at])
  @@index([storeId, at])
}

// 車両と顧客の関連。所有権移転（Phase2）に備えて期間を持たせる。
// 履歴は「人」ではなく「車」に紐づける方針のため、証明書はここを介さず vehicleId を直接持つ。
model PitVehicleCustomer {
  id         String      @id @default(cuid())
  vehicleId  String
  vehicle    PitVehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId String
  customer   PitCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startedOn  DateTime    @default(now())
  endedOn    DateTime? // null = 現在の所有者
  createdAt  DateTime    @default(now())

  @@unique([vehicleId, customerId, startedOn])
  @@index([vehicleId, endedOn])
}

// 施工証明書（1作業＝1証明書）。車両に紐づけ、顧客には紐づけない（所有権移転で履歴が切れないため）。
// 発行後は内容変更不可。訂正は voided にして replacesId を付けた新しい証明書を発行する。
model PitCertificate {
  id         String      @id @default(cuid())
  vehicleId  String
  vehicle    PitVehicle  @relation(fields: [vehicleId], references: [id])
  storeId    String
  store      PitStore    @relation(fields: [storeId], references: [id])
  customerId String? // 法定記録簿の「依頼者」。店舗が保持する顧客情報への参照
  customer   PitCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  shareToken  String  @unique // 共有URL用の推測不能トークン（無効化可能）
  shareRevoked Boolean @default(false)
  verifyLast3 String  @default("") // 任意の簡易照合（既存のchassisLast3に合わせ、新たな平文断片は増やさない）

  serviceDate             DateTime // 施工日
  odometerKm              Int? // 施工時走行距離
  staffName               String   @default("")
  staffLicenseNo          String   @default("") // 資格番号（非公開）
  workSummary             String   @default("")
  totalAmount             Int? // 施工金額（非公開）
  restorationCostEstimate Int? // 再施工費用の目安（保険説明用・非公開）
  certificateType         String // coating | ecu | aiming | tire | repair_history | battery | general
  legalRecord             Boolean  @default(false) // 法定記録簿モードで作成（認証/指定工場のみ）

  payloadHash String    @default("") // 発行時点の内容ハッシュ（第三者検証用）
  issuedAt    DateTime? // 発行日時（null=下書き）
  status      String    @default("draft") // draft | issued | voided | failed
  errorMessage String   @default("") // 作成に失敗した理由（画面に出して再試行させる。沈黙させない）
  // 保存期間は目的別。この日までは削除しない（加盟店退会時も含む）
  //  legal_record = 記載日から2年 / warranty = 保証期間満了まで / none = 保持理由なし
  retentionUntil  DateTime?
  retentionReason String   @default("none")
  voidedAt    DateTime?
  voidReason  String    @default("")
  replacesId  String? // 訂正再発行の元証明書

  blogPostId String? // ①公開ブログ記事との紐付け
  blogPost   PitPost? @relation(fields: [blogPostId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  details PitCertificateDetail[]
  media   PitCertificateMedia[]

  @@index([storeId, createdAt])
  @@index([vehicleId, serviceDate])
  @@index([status])
}

// 施工種別モジュールの値（key-value）。項目追加でスキーマ変更が起きないようにする。
// 項目定義（表示名・型・必須・単位）は src/server/pit/cert-fields.ts が唯一の原本。
model PitCertificateDetail {
  id            String         @id @default(cuid())
  certificateId String
  certificate   PitCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  module        String // coating | ecu | aiming | tire | repair_history | battery
  fieldKey      String
  fieldValue    String         @default("")
  unit          String         @default("")

  @@unique([certificateId, module, fieldKey])
}

// 証明書に添付する写真。公開ブログへ回せるかは isPublicSafe で明示する
// （車検証・ナンバーが写ったものは false のまま＝公開側へ渡さない）
model PitCertificateMedia {
  id            String         @id @default(cuid())
  certificateId String
  certificate   PitCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  storageKey    String // 認可付きルート経由で配信（公開URLは持たない）
  kind          String // before | after | product_label | vehicle_plate | diagnostic_screen | other
  takenAt       DateTime?
  exifJson      Json? // 撮影情報（証跡用・公開しない）
  hash          String         @default("")
  isPublicSafe  Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@index([certificateId])
}

// 第三者提供の同意記録（Phase2の所有権移転で必要。後付けが困難なため器だけ先に用意）
model PitConsent {
  id          String      @id @default(cuid())
  customerId  String
  customer    PitCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId   String?
  purpose     String // 例: transfer_to_new_owner
  textVersion String      @default("") // 同意時に提示した文面のバージョン
  agreedAt    DateTime    @default(now())
  agreedVia   String      @default("") // 店頭 / 共有ページ 等
  note        String      @default("")

  @@index([customerId, purpose])
}

// 投稿1件（公開ログを兼ねる）
model PitPost {
  id            String      @id @default(cuid())
  storeId       String
  store         PitStore    @relation(fields: [storeId], references: [id])
  vehicle       String // 車種（フリーテキスト）
  category      String // 公式8ジャンルslug（src/config/mbpit-genres.json参照）。旧値 polish/other が既存行に残存
  memo          String?
  photoKeys     Json        @default("[]") // storage上のキー（処理済み画像）
  // draft=証明書から作られたスタンバイ（記事未生成）/ review=生成済みで公開前の確認待ち
  status        String      @default("processing") // processing | review | published | held | failed | deleted | draft
  editNote      String      @default("") // 公開後の追記（訂正・補足）。記事末尾に反映する
  /*
   * 生成した記事本文（WPへ送るHTML）。公開前確認（status="review"）で
   * 店舗が中身を読めるようにするため保存する。以前は本文を一切保存しておらず、
   * 生成→即公開の間に人が見る手段が無かった。
   */
  bodyHtml      String?
  guardResult   String? // ガード判定の内訳（held理由・注意書き挿入等）
  title         String?
  wpPostId      Int?
  publishedUrl  String?
  errorMessage  String?
  plateLog      Json        @default("[]") // ナンバー検出結果ログ（未検出画像の記録）
  vehicleId     String? // 車検証QRで紐づけた車両（任意）
  vehicleRef    PitVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  externalProof Json? // 施工証明の外部連携スロット {provider, tx_id, url}（Ledra等、現状は未使用）
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  certificates PitCertificate[]

  @@index([storeId, createdAt])
  @@index([status])
  @@index([vehicleId])
}

// ── 実車開発モード（開発ツリー） ──
// 本部が候補ファイルをツリー状に繋ぎ、代理店の「良い/ダメ」報告で次のノードを開放する。
model DevNode {
  id        String        @id @default(cuid())
  recordId  String
  record    ServiceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  label     String // 「①ベース仕様」
  note      String? // 何を変えたか・現場で見てほしい点
  filePath  String? // チューニング済みbin（mod）。slave化はDL時に行う
  fileName  String?
  fileHash  String?
  // true = filePath が暗号化済み .slave（チャット添付から取り込んだ場合）。DL時は再暗号化せずそのまま配信。
  fileIsSlave Boolean @default(false)
  okNextId  String? // 良ければ次へ
  ngNextId  String? // ダメなら次へ
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  trials DevTrial[]

  @@index([recordId, sortOrder])
}

// 試行ログ（どのノードをいつ試して結果がどうだったか）
model DevTrial {
  id        String   @id @default(cuid())
  recordId  String
  nodeId    String
  node      DevNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  result    String // ok | ng
  comment   String?
  byUserId  String?
  createdAt DateTime @default(now())

  @@index([recordId, createdAt])
}

// ── 左右ECU（1台に2基のECUがある車） ──
// 記録は1つにまとめ、bak系（フルバックアップ）だけ側ごとに分ける。
// キャリブレーション(.slave)は左右共通のため、既存のメインID（=primarySide側）をそのまま使う。
model RecordEcuSide {
  id               String        @id @default(cuid())
  recordId         String
  record           ServiceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  side             String // 「左」「右」等の表示ラベル（primarySideと重複不可）
  slaveFilePath    String // この側のスレーブ
  slaveHash        String?
  ecuType          String?
  backupSupported  Boolean?
  autotunerSlaveId String?
  autotunerEcuId   Int?
  autotunerModelId Int?
  autotunerMcuId   String?
  createdAt        DateTime      @default(now())

  @@unique([recordId, side])
}


// AIのCal誤認の拒否リスト（多数のdumpに共通するライブラリ定数など）。
// 本店がCalを手修正すると、AIが出していた誤値が自動で追加される。
model EcuDenyToken {
  token     String   @id
  note      String?
  createdAt DateTime @default(now())
}

// WordPress同期の履歴。payloadHash が直前の成功と同じなら送信をスキップする。
// backup には置換前のページ全文（content.raw）を保存し、iframe置換(Step D)の復旧にも使う。
model PriceSyncLog {
  id          String   @id @default(cuid())
  wpPageId    Int
  brandIds    String[] @default([])
  payloadHash String
  status      String // success | skipped | failed
  error       String?
  backup      String?
  createdAt   DateTime @default(now())

  @@index([wpPageId, createdAt])
}

// 個人情報（車台番号・登録番号）の復号アクセスログ。
// 「いつ・誰が・どの証明書の・何を・なぜ」復号したかを残す。個人情報を扱うため追跡可能にする。
// 復号関数がこのログの書き込みを内包しているため、記録されない復号経路は実装できない。
model PitPiiAccessLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actorRole     String
  field         String // vin | regNumber
  purpose       String // certificate_pdf | legal_record | export | ...
  certificateId String?
  vehicleId     String?
  keyId         String? // 復号に使った鍵のID（ローテーション追跡用）
  ok            Boolean  @default(true)
  at            DateTime @default(now())

  @@index([certificateId, at])
  @@index([actorUserId, at])
}

// 車両ページ「対応オプション」の語彙マスタ。管理画面から追加・並べ替え・削除できる。
// 既定8件は migration で投入。key は VehiclePage.options の JSON キーと対応。
model VehiclePageOption {
  id           String   @id @default(cuid())
  key          String   @unique // "coldStartOff" 等（JSONキー・変更不可運用）
  labelJa      String
  labelEn      String
  shortLabel   String? // 価格表グリッドの列見出し（短縮）
  derivedFrom  String? // 価格列key（値があれば〇と自動判定。手動設定が優先）
  displayOrder Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}
