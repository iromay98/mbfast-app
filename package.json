{
  "name": "mbfast-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:price-templates": "tsx scripts/check-generated-templates.mts",
    "check:price-golden": "tsx scripts/verify-price-html.mts",
    "pg:init": "bash scripts/pg.sh init",
    "pg:start": "bash scripts/pg.sh start",
    "pg:stop": "bash scripts/pg.sh stop",
    "pg:status": "bash scripts/pg.sh status",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "prebuild": "node scripts/copy-ort-wasm.mjs",
    "predev": "node scripts/copy-ort-wasm.mjs",
    "check:cert-privacy": "tsx scripts/check-cert-privacy.mts",
    "check:shaken-ocr": "tsx scripts/check-shaken-ocr.mts",
    "check:photo-ocr": "tsx scripts/check-photo-ocr.mts",
    "check:store-isolation": "tsx -r dotenv/config scripts/check-store-isolation.mts",
    "check:variant-replace": "tsx scripts/check-variant-replace.mts",
    "report:variant-dupes": "tsx -r dotenv/config scripts/report-variant-duplicates.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jsqr": "^1.4.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "onnxruntime-web": "^1.27.0",
    "papaparse": "^5.5.4",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
